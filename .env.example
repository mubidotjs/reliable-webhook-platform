# PostgreSQL: pooled in production, direct locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/reliable_webhooks?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/reliable_webhooks?schema=public

# Better Auth / GitHub OAuth.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Used from M1 onward for encrypted endpoint secrets.
ENCRYPTION_KEY_VERSION=v1
ENCRYPTION_KEY_V1=replace-with-32-byte-base64url-key

# Queue defaults to the local PostgreSQL adapter.
QUEUE_ADAPTER=local
# Public application origin used to verify QStash callback signatures.
APP_URL=https://your-app.example
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

RECEIVER_URL=http://localhost:4000
LOG_LEVEL=info

# M4 limits: positive integers; defaults preserve the public-demo budget.
EVENT_BODY_LIMIT_BYTES=262144
DAILY_TENANT_DELIVERY_LIMIT=25
DAILY_GLOBAL_DELIVERY_LIMIT=100
DAILY_PUBLICATION_LIMIT=650
MUTATION_REQUESTS_PER_MINUTE=120
